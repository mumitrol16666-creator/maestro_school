FROM node:22-alpine

WORKDIR /app

ARG NEXT_PUBLIC_API_URL=/api/v1
ARG API_PROXY_TARGET=http://backend:4000
ARG NEXT_PUBLIC_RELEASE_SHA=dev
ARG NEXT_PUBLIC_RELEASE_BUILT_AT=unknown

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV API_PROXY_TARGET=${API_PROXY_TARGET}
ENV NEXT_PUBLIC_RELEASE_SHA=${NEXT_PUBLIC_RELEASE_SHA}
ENV NEXT_PUBLIC_RELEASE_BUILT_AT=${NEXT_PUBLIC_RELEASE_BUILT_AT}

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN NEXT_PUBLIC_RELEASE_SHA="${NEXT_PUBLIC_RELEASE_SHA}-$(date +%s)" npm run build

EXPOSE 3000

CMD ["npm", "run", "start", "--", "-H", "0.0.0.0", "-p", "3000"]
