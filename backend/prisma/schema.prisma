model User {
  id                String   @id @default(uuid()) @db.Uuid
  login             String?  @unique @db.VarChar(64)
  email             String?  @unique @db.VarChar(255)
  phone             String   @db.VarChar(32)
  passwordHash      String   @map("password_hash") @db.VarChar(255)
  firstName         String   @map("first_name") @db.VarChar(128)
  lastName          String   @map("last_name") @db.VarChar(128)
  middleName        String?  @map("middle_name") @db.VarChar(128)
  avatar            String?  @db.VarChar(512)
  profileBio        String?  @map("profile_bio") @db.Text
  profileInstrument String?  @map("profile_instrument") @db.VarChar(128)
  profileInterests  String[] @default([]) @map("profile_interests")
  profilePublic     Boolean  @default(false) @map("profile_public")
  roleId            String   @map("role_id") @db.Uuid
  isActive          Boolean  @default(true) @map("is_active")
  leagueEligible    Boolean  @default(true) @map("league_eligible")

  // Integration: CRM user link
  crmStudentId       String?   @unique @map("crm_student_id") @db.VarChar(64)
  crmTeacherId       String?   @unique @map("crm_teacher_id") @db.VarChar(64)
  phoneNormalized    String?   @map("phone_normalized") @db.VarChar(32)
  externalLinkStatus String?   @map("external_link_status") @db.VarChar(32)
  linkedAt           DateTime? @map("linked_at") @db.Timestamptz(6)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  role Role @relation(fields: [roleId], references: [id])

  teacherProfile                     Teacher?
  studentCourses                     StudentCourse[]
  lessonProgress                     LessonProgress[]
  homeworkSubmissions                HomeworkSubmission[]                   @relation("HomeworkStudent")
  reviewedSubmissions                HomeworkSubmission[]                   @relation("HomeworkReviewer")
  pointsReceived                     PointsTransaction[]                    @relation("PointsStudent")
  pointsAwarded                      PointsTransaction[]                    @relation("PointsAwarder")
  leagueXpEvents                     LeagueXpEvent[]                        @relation("LeagueXpStudent")
  leagueXpAwarded                    LeagueXpEvent[]                        @relation("LeagueXpAwarder")
  weeklyLeagueAwards                 WeeklyLeagueAward[]
  weeklyLeagueSnapshotEntries        WeeklyLeagueSnapshotEntry[]
  weeklyLeagueActivities             WeeklyLeagueActivityEvent[]
  weeklyStreakStates                 WeeklyStreakState[]
  weeklyStreakEvents                 WeeklyStreakEvent[]
  weeklyStreakProtections            WeeklyStreakProtection[]               @relation("WeeklyStreakProtectedStudent")
  weeklyStreakProtectionsCreated     WeeklyStreakProtection[]               @relation("WeeklyStreakProtectionCreator")
  weeklyStreakProtectionsRevoked     WeeklyStreakProtection[]               @relation("WeeklyStreakProtectionRevoker")
  weeklyStreakMilestones             WeeklyStreakMilestone[]
  achievements                       StudentAchievement[]
  newsPosts                          NewsPost[]
  auditLogs                          AuditLog[]
  pushSubscriptions                  PushSubscription[]
  lessonQuestions                    LessonQuestion[]
  onlineLessonRequestsAsStudent      OnlineLessonRequest[]                  @relation("OnlineLessonStudent")
  onlineLessonRequestsAsTeacher      OnlineLessonRequest[]                  @relation("OnlineLessonTeacher")
  onlineLessonRequestsCompleted      OnlineLessonRequest[]                  @relation("OnlineLessonCompleter")
  onlineLessonAssignmentSubmissions  OnlineLessonAssignmentSubmission[]     @relation("OnlineAssignmentStudent")
  onlineLessonAssignmentReviews      OnlineLessonAssignmentSubmission[]     @relation("OnlineAssignmentReviewer")
  coinBalance                        StudentCoinBalance?
  maestroCoinTransactions            MaestroCoinTransaction[]               @relation("CoinStudent")
  maestroCoinsAwarded                MaestroCoinTransaction[]               @relation("CoinAwarder")
  notifications                      UserNotification[]
  offlineLessonStudentChecks         OfflineLessonStudentCheck[]
  studentMonthlyPlans                StudentMonthlyPlan[]
  groupMonthlyPlans                  GroupMonthlyPlan[]
  messageConversationsAsStudent      TeacherConversation[]                  @relation("TeacherConversationStudent")
  messageConversationsAsTeacher      TeacherConversation[]                  @relation("TeacherConversationTeacher")
  directMessages                     TeacherMessage[]                       @relation("TeacherMessageSender")
  preparedTestAttempts               PreparedTestAttempt[]                  @relation("PreparedTestStudent")
  preparedTestDrafts                 PreparedTestDraft[]                    @relation("PreparedTestDraftStudent")
  rewardRedemptions                  RewardRedemption[]                     @relation("RewardStudent")
  processedRewardRedemptions         RewardRedemption[]                     @relation("RewardProcessor")
  parentLinksAsParent                ParentStudentLink[]                    @relation("ParentLinkParent")
  parentLinksAsStudent               ParentStudentLink[]                    @relation("ParentLinkStudent")
  parentLinksCreated                 ParentStudentLink[]                    @relation("ParentLinkCreator")
  parentVisibilityPolicy             ParentVisibilityPolicy?                @relation("ParentVisibilityStudent")
  parentVisibilityPoliciesUpdated    ParentVisibilityPolicy[]               @relation("ParentVisibilityUpdater")
  parentVisibilityRequests           ParentVisibilityRequest[]              @relation("ParentVisibilityRequestStudent")
  parentVisibilityRequestsDecided    ParentVisibilityRequest[]              @relation("ParentVisibilityRequestDecider")
  learningTopicsCreated              LearningTopic[]                        @relation("LearningTopicCreator")
  learningTopicsResponsible          LearningTopic[]                        @relation("LearningTopicResponsibleTeacher")
  learningTopicProgressChanges       LearningTopicProgress[]                @relation("LearningTopicProgressAuthor")
  learningPlansCreated               LearningPlan[]                         @relation("LearningPlanCreator")
  learningPlanVersionsCreated        LearningPlanVersion[]                  @relation("LearningPlanVersionCreator")
  learningHomeworkAssignmentsCreated LearningHomeworkAssignment[]           @relation("LearningHomeworkAssignmentCreator")
  learningHomeworkRecipients         LearningHomeworkRecipient[]            @relation("LearningHomeworkRecipientStudent")
  learningHomeworkRecipientsReviewed LearningHomeworkRecipient[]            @relation("LearningHomeworkRecipientReviewer")
  learningHomeworkAttempts           LearningHomeworkAttempt[]              @relation("LearningHomeworkAttemptStudent")
  learningHomeworkReviews            LearningHomeworkReview[]               @relation("LearningHomeworkReviewReviewer")
  economicEpochParticipants          EconomicEpochParticipant[]
  adminJournalActions                AdminJournalAction[]                   @relation("AdminJournalActionActor")
  learningConversationMemberships    LearningConversationMember[]
  learningMessagesAuthored           LearningMessage[]                      @relation("LearningMessageAuthor")
  learningMessagesHidden             LearningMessage[]                      @relation("LearningMessageHiddenBy")
  learningMessageVersionsAuthored    LearningMessageVersion[]               @relation("LearningMessageVersionAuthor")
  learningMessageAttachmentsUploaded LearningMessageAttachment[]            @relation("LearningMessageAttachmentUploader")
  learningMessageReportsCreated      LearningMessageReport[]                @relation("LearningMessageReportReporter")
  learningMessageReportsResolved     LearningMessageReport[]                @relation("LearningMessageReportResolver")
  learningModerationActionsCreated   LearningConversationModerationAction[] @relation("LearningModerationActor")
  learningModerationActionsTargeted  LearningConversationModerationAction[] @relation("LearningModerationTargetUser")
  learningConversationMemberEvents   LearningConversationMembershipEvent[]
  appUsageEvents                     AppUsageEvent[]

  @@index([roleId])
  @@index([email])
  @@index([login])
  @@index([phoneNormalized])
  @@index([isActive])
  @@index([deletedAt])
  @@index([crmStudentId])
  @@index([crmTeacherId])
  @@map("users")
}

model ParentStudentLink {
  id            String    @id @default(uuid()) @db.Uuid
  parentUserId  String    @map("parent_user_id") @db.Uuid
  studentUserId String    @map("student_user_id") @db.Uuid
  relationship  String    @default("guardian") @db.VarChar(32)
  isActive      Boolean   @default(true) @map("is_active")
  createdById   String?   @map("created_by_id") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)

  parent    User  @relation("ParentLinkParent", fields: [parentUserId], references: [id], onDelete: Cascade)
  student   User  @relation("ParentLinkStudent", fields: [studentUserId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ParentLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([parentUserId, studentUserId])
  @@index([parentUserId, isActive])
  @@index([studentUserId, isActive])
  @@index([createdById])
  @@map("parent_student_links")
}

model ParentVisibilityPolicy {
  id               String   @id @default(uuid()) @db.Uuid
  studentId        String   @unique @map("student_id") @db.Uuid
  showSchedule     Boolean  @default(true) @map("show_schedule")
  showBalance      Boolean  @default(true) @map("show_balance")
  showPlanProgress Boolean  @default(true) @map("show_plan_progress")
  showAchievements Boolean  @default(true) @map("show_achievements")
  updatedById      String?  @map("updated_by_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student   User  @relation("ParentVisibilityStudent", fields: [studentId], references: [id], onDelete: Cascade)
  updatedBy User? @relation("ParentVisibilityUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedById])
  @@map("parent_visibility_policies")
}

model ParentVisibilityRequest {
  id                        String    @id @default(uuid()) @db.Uuid
  studentId                 String    @map("student_id") @db.Uuid
  requestedShowSchedule     Boolean   @map("requested_show_schedule")
  requestedShowBalance      Boolean   @map("requested_show_balance")
  requestedShowPlanProgress Boolean   @map("requested_show_plan_progress")
  requestedShowAchievements Boolean   @map("requested_show_achievements")
  note                      String?   @db.Text
  status                    String    @default("pending") @db.VarChar(32)
  decidedById               String?   @map("decided_by_id") @db.Uuid
  decisionNote              String?   @map("decision_note") @db.Text
  decidedAt                 DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  student   User  @relation("ParentVisibilityRequestStudent", fields: [studentId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("ParentVisibilityRequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([studentId, status, createdAt])
  @@index([decidedById])
  @@map("parent_visibility_requests")
}

model PreparedTestAttempt {
  id              String   @id @default(uuid()) @db.Uuid
  testId          String   @map("test_id") @db.VarChar(128)
  studentId       String   @map("student_id") @db.Uuid
  attemptNumber   Int      @map("attempt_number")
  score           Int
  correctAnswers  Int      @map("correct_answers")
  totalQuestions  Int      @map("total_questions")
  passed          Boolean
  answers         Json     @db.JsonB
  durationSeconds Int?     @map("duration_seconds")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student User @relation("PreparedTestStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, testId, attemptNumber])
  @@index([studentId, testId, createdAt])
  @@index([testId, createdAt])
  @@map("prepared_test_attempts")
}

model PreparedTestDraft {
  id              String   @id @default(uuid()) @db.Uuid
  testId          String   @map("test_id") @db.VarChar(128)
  studentId       String   @map("student_id") @db.Uuid
  answers         Json     @db.JsonB
  currentQuestion Int      @default(0) @map("current_question")
  startedAt       DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  student User @relation("PreparedTestDraftStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, testId])
  @@index([studentId, updatedAt])
  @@map("prepared_test_drafts")
}

model OfflineLessonStudentCheck {
  id                         String    @id @default(uuid()) @db.Uuid
  crmClassId                 String    @map("crm_class_id") @db.VarChar(128)
  crmStudentId               String    @map("crm_student_id") @db.VarChar(128)
  teacherUserId              String?   @map("teacher_user_id") @db.Uuid
  attendanceStatus           String    @default("unmarked") @map("attendance_status") @db.VarChar(32)
  homeworkStatus             String    @default("not_checked") @map("homework_status") @db.VarChar(32)
  homeworkCompletionPercent  Int?      @map("homework_completion_percent")
  homeworkDifficulties       String?   @map("homework_difficulties") @db.Text
  homeworkNotCompletedReason String?   @map("homework_not_completed_reason") @db.Text
  reviewedHomeworkCrmClassId String?   @map("reviewed_homework_crm_class_id") @db.VarChar(128)
  teacherNote                String?   @map("teacher_note") @db.Text
  lessonPoints               Int       @default(0) @map("lesson_points")
  monthlyPlanId              String?   @map("monthly_plan_id") @db.Uuid
  planTopicUpdates           Json      @default("[]") @map("plan_topic_updates") @db.JsonB
  rewardsAppliedAt           DateTime? @map("rewards_applied_at") @db.Timestamptz(6)
  syncRevision               Int       @default(0) @map("sync_revision")
  syncStatus                 String    @default("synced") @map("sync_status") @db.VarChar(32)
  lastSyncError              String?   @map("last_sync_error") @db.Text
  syncedAt                   DateTime? @map("synced_at") @db.Timestamptz(6)
  markedAt                   DateTime  @default(now()) @map("marked_at") @db.Timestamptz(6)
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacherUser User? @relation(fields: [teacherUserId], references: [id], onDelete: SetNull)

  @@unique([crmClassId, crmStudentId])
  @@index([teacherUserId])
  @@index([crmClassId])
  @@index([reviewedHomeworkCrmClassId])
  @@map("offline_lesson_student_checks")
}

model OfflineLessonProjection {
  crmClassId    String    @id @map("crm_class_id") @db.VarChar(128)
  crmTeacherId  String?   @map("crm_teacher_id") @db.VarChar(128)
  status        String    @db.VarChar(64)
  lessonPayload Json      @map("lesson_payload") @db.JsonB
  rosterPayload Json?     @map("roster_payload") @db.JsonB
  rosterVersion String?   @map("roster_version") @db.VarChar(64)
  crmUpdatedAt  DateTime? @map("crm_updated_at") @db.Timestamptz(6)
  lastSyncedAt  DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  lastSyncError String?   @map("last_sync_error") @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  report OfflineLessonReport?

  @@index([crmTeacherId, status])
  @@index([lastSyncedAt])
  @@map("offline_lesson_projections")
}

model OfflineLessonReport {
  id               String    @id @default(uuid()) @db.Uuid
  crmClassId       String    @unique @map("crm_class_id") @db.VarChar(128)
  authorUserId     String    @map("author_user_id") @db.Uuid
  status           String    @default("editing") @db.VarChar(32)
  currentVersion   Int       @default(0) @map("current_version")
  confirmedVersion Int?      @map("confirmed_version")
  crmConfirmedAt   DateTime? @map("crm_confirmed_at") @db.Timestamptz(6)
  correctionReason String?   @map("correction_reason") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  projection OfflineLessonProjection      @relation(fields: [crmClassId], references: [crmClassId], onDelete: Restrict)
  versions   OfflineLessonReportVersion[]
  drafts     OfflineLessonDraft[]

  @@index([authorUserId, status])
  @@index([status, updatedAt])
  @@map("offline_lesson_reports")
}

model OfflineLessonReportVersion {
