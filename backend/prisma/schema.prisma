// ─── Economic epochs ───────────────────────────────────────────────────────

model EconomicEpoch {
  id              String              @id @default(uuid()) @db.Uuid
  code            String              @unique @db.VarChar(64)
  name            String              @db.VarChar(255)
  startsAt        DateTime            @map("starts_at") @db.Timestamptz(6)
