{
  "name": "@maestro/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Maestro educational platform — API & data layer",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:qa": "tsx scripts/qa-seed.ts",
    "db:seed:qa:ui": "npm run db:seed:qa && npm run admin-journal:v2:fixture && npm run learning-dialogs-v2:ui-fixture",
    "db:reset:qa": "tsx scripts/qa-reset.ts",
    "db:prepare-production": "tsx scripts/prepare-production.ts",
    "release:preflight": "tsx scripts/release-preflight.ts",
    "release:dependencies": "tsx scripts/release-dependencies-preflight.ts",
    "topics-v2:migrate": "tsx scripts/learning-topics-v2-migration.ts",
    "product:inventory": "tsx scripts/product-baseline.ts",
    "economy:v2:cutover:dry-run": "tsx scripts/economy-v2-cutover.ts --dry-run",
    "economy:v2:cutover:apply": "tsx scripts/economy-v2-cutover.ts --apply",
    "economy:v2:ui-fixture": "tsx scripts/economy-v2-ui-fixture.ts",
    "economy:v2:ui-fixture:cleanup": "tsx scripts/economy-v2-ui-fixture.ts --cleanup",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test --test-force-exit --test-concurrency=1 $(find src -type f -name '*.test.ts' | sort)",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:production": "tsx scripts/production-smoke.ts",
    "e2e": "tsx scripts/e2e-flow.ts",
    "e2e:parent-family": "tsx scripts/parent-family-e2e.ts",
    "e2e:online-lessons": "tsx scripts/online-lessons-e2e.ts",
    "e2e:learning-v2": "tsx scripts/learning-plan-v2-e2e.ts",
    "e2e:homework-v2": "tsx scripts/homework-flow-v2-e2e.ts",
    "e2e:lesson-v2-rewards": "tsx scripts/lesson-v2-rewards-e2e.ts",
    "e2e:economy-v2-cutover": "tsx scripts/economy-v2-cutover-e2e.ts",
    "e2e:weekly-league-v2": "tsx scripts/weekly-league-v2-e2e.ts",
    "e2e:admin-journal-v2": "tsx scripts/admin-journal-v2-e2e.ts",
    "e2e:parent-visibility-v2": "tsx scripts/parent-visibility-v2-e2e.ts",
    "e2e:learning-dialog-membership-v2": "tsx scripts/learning-dialog-membership-v2-e2e.ts",
    "e2e:learning-dialog-api-v2": "tsx scripts/learning-dialog-api-v2-e2e.ts",
    "e2e:learning-dialog-moderation-v2": "tsx scripts/learning-dialog-moderation-v2-e2e.ts",
    "e2e:learning-dialog-retention-v2": "tsx scripts/learning-dialog-retention-v2-e2e.ts",
    "learning-dialogs-v2:ui-fixture": "tsx scripts/learning-dialog-ui-fixture.ts",
    "learning-dialogs-v2:ui-fixture:cleanup": "tsx scripts/learning-dialog-ui-fixture.ts --cleanup",
    "learning-dialogs-v2:migrate:dry-run": "tsx scripts/learning-dialog-legacy-migration.ts --dry-run",
    "learning-dialogs-v2:migrate:apply": "tsx scripts/learning-dialog-legacy-migration.ts --apply",
    "admin-journal:v2:fixture": "tsx scripts/admin-journal-v2-fixture.ts",
    "admin-journal:v2:fixture:cleanup": "tsx scripts/admin-journal-v2-fixture.ts --cleanup",
    "cms:smoke": "tsx scripts/cms-smoke.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^10.2.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.3.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.7",
    "@types/web-push": "^3.6.4",
    "prisma": "^6.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
